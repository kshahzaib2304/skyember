            <section class="contact-page" aria-labelledby="contact-heading">
        <div class="container-sky contact-grid">
            <nav class="contact-crumb" aria-label="Breadcrumb">
                <ol>
                    <li>
                        <a href="http://127.0.0.1:8000">Home</a>
                        <span aria-hidden="true">/</span>
                    </li>
                    <li aria-current="page">Contact</li>
                </ol>
            </nav>

            <h1 id="contact-heading" class="contact-title">
                <span>Tell us what</span>
                <span>you're trying</span>
                <span>to solve.</span>
            </h1>

            <p class="text-body contact-summary">
                A short brief is enough. We read it and reply with the next step.
            </p>

            <div class="contact-direct">
                <p class="text-eyebrow">Direct</p>
                <a class="contact-mail" href="mailto:hello@skyember.com">hello@skyember.com</a>
                <p class="text-small contact-direct-note">Write directly if you already know what to say.</p>
            </div>

            <form
                id="brief"
                class="contact-form"
                method="post"
                action="http://127.0.0.1:8000/contact"
                accept-charset="UTF-8"
                novalidate
                aria-labelledby="contact-heading"
            >
                <input type="hidden" name="_token" value="diohyIyzHVqoeJFOiSuW5mJDs9McinYACHl9vIgb" autocomplete="off">
                <div class="contact-trap" aria-hidden="true">
                    <label for="company-website">Company website</label>
                    <input id="company-website" type="text" name="company_website" tabindex="-1" autocomplete="off" value="">
                </div>

                                    <div class="contact-letter" id="brief-status" role="status">
                        <p class="text-eyebrow">Ready to send</p>
                        <p class="contact-letter-to">To hello@skyember.com</p>
                        <pre class="contact-letter-body">Name: Ada Lovelace
Email: ada@example.com
Organization: Northwind

The counter cannot reserve stock without breaking the earliest-expiry rule.</pre>
                        <a class="btn btn-primary contact-send" href="mailto:hello@skyember.com?subject=Brief%20from%20Northwind&amp;body=Name%3A%20Ada%20Lovelace%0AEmail%3A%20ada%40example.com%0AOrganization%3A%20Northwind%0A%0AThe%20counter%20cannot%20reserve%20stock%20without%20breaking%20the%20earliest-expiry%20rule.">Open email to send</a>
                    </div>
                
                
                <div class="contact-field ">
                    <label for="name">Name</label>
                    <input
                        id="name"
                        name="name"
                        type="text"
                        value="Ada Lovelace"
                        autocomplete="name"
                        maxlength="120"
                        required
                        spellcheck="false"
                                            >
                                    </div>

                <div class="contact-field ">
                    <label for="email">Work email</label>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        value="ada@example.com"
                        autocomplete="email"
                        inputmode="email"
                        autocapitalize="none"
                        maxlength="160"
                        required
                        spellcheck="false"
                                            >
                                    </div>

                <div class="contact-field ">
                    <label for="organization">Organization</label>
                    <input
                        id="organization"
                        name="organization"
                        type="text"
                        value="Northwind"
                        autocomplete="organization"
                        maxlength="160"
                        required
                        spellcheck="false"
                                            >
                                    </div>

                <fieldset class="contact-kinds" >
                    <legend>
                        What kind of system
                        <span class="contact-optional">Optional</span>
                    </legend>
                                            <label class="contact-choice" for="kind-business">
                            <input
                                id="kind-business"
                                type="radio"
                                name="kind"
                                value="business"
                                                            >
                            <span>Business software</span>
                        </label>
                                            <label class="contact-choice" for="kind-product">
                            <input
                                id="kind-product"
                                type="radio"
                                name="kind"
                                value="product"
                                                            >
                            <span>Digital product</span>
                        </label>
                                            <label class="contact-choice" for="kind-automation">
                            <input
                                id="kind-automation"
                                type="radio"
                                name="kind"
                                value="automation"
                                                            >
                            <span>AI and automation</span>
                        </label>
                                            <label class="contact-choice" for="kind-cloud">
                            <input
                                id="kind-cloud"
                                type="radio"
                                name="kind"
                                value="cloud"
                                                            >
                            <span>Cloud and engineering</span>
                        </label>
                                            <label class="contact-choice" for="kind-unsure">
                            <input
                                id="kind-unsure"
                                type="radio"
                                name="kind"
                                value="unsure"
                                                            >
                            <span>Not sure yet</span>
                        </label>
                                                        </fieldset>

                <div class="contact-field ">
                    <label for="problem">The problem</label>
                    <textarea
                        id="problem"
                        name="problem"
                        rows="6"
                        maxlength="1200"
                        required
                        spellcheck="true"
                        aria-describedby="problem-hint"
                                            >The counter cannot reserve stock without breaking the earliest-expiry rule.</textarea>
                    <p class="contact-hint" id="problem-hint">A few sentences about the operation, the product, or the constraint.</p>
                                    </div>

                <div class="contact-actions">
                    <button type="submit" class="btn btn-secondary">
                        Update the brief
                    </button>
                </div>

                <p class="contact-note">
                    You will get the finished brief in your email, addressed to hello@skyember.com. Nothing is sent until you send it there.
                </p>
            </form>
        </div>
